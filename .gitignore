*.py[cod]
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.coverage
htmlcov/
*.log

# Credentials and local settings
.env
.env.*
!.env.example
*.pem
*.key
.aws/
.vscode/
.idea/

# Local agent tools, Spec Kit, plans and handoff notes
/.agents/
/.codex/
/.specify/
/.impeccable/
