# Keep only helpers imported by the automated test suite
/qa/*
!/qa/ai_evaluation_cases.py
!/qa/run_ai_evaluation.py
!/qa/verify_order_flow.py

# Machine-specific database maintenance scripts
/tools/upgrade_cost_schema.py
/tools/verify_cost_revision.py

